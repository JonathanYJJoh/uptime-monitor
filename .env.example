# Copy to .env for local development. Never commit .env.
POSTGRES_USER=uptime
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=uptime

# Used by the worker and API when running on your laptop (outside Docker).
# Inside Docker Compose the host is "postgres" instead of "localhost".
DATABASE_URL=postgresql://uptime:change-me-local-only@localhost:5432/uptime
